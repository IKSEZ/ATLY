# ============================================================
# .env.example — copie para .env e preencha os valores reais
# NUNCA suba o .env para o GitHub! Adicione ao .gitignore
# ============================================================

PORT=3000
FRONTEND_URL=http://localhost:5173

# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atly_db
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# JWT — use uma string longa e aleatória em produção
JWT_SECRET=gere_uma_string_aleatoria_longa_aqui

# URL do microserviço Python de IA
IA_SERVICE_URL=http://localhost:8000
